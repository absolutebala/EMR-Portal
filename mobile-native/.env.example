# Copy to .env.local (git-ignored) and fill in real values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Points at the deployed EMR Portal backend. Override to a LAN IP when testing against
# a locally-running `npm run dev` in the main emr-portal app — "localhost" from a
# physical device or simulator does not resolve to your Mac.
EXPO_PUBLIC_API_BASE_URL=https://emr-portal-three.vercel.app
