# Copy to .env.local (git-ignored) and fill in real values.

# Client-safe (exposed in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Base URL this app is reachable at — used to build links in invite emails and
# "share login details" text. In production this is the ALB DNS name (or custom
# domain, once one exists).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets — never prefix with NEXT_PUBLIC_, never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@emrglobal.com
# Bearer-token secret validating app/api/cron/daily-reminders — must always be set in
# any real environment (the route silently skips auth if this is unset).
CRON_SECRET=
